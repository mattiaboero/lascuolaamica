/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-DNS-Prefetch-Control: on
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), accelerometer=(), gyroscope=(), magnetometer=()
  Content-Security-Policy: require-trusted-types-for 'script'; default-src 'self'; script-src 'self'; style-src 'self' 'sha256-BNmAHbO2/ek3x7c/V95X+65lWTk5Sab4/A58ijnWg0g=' 'sha256-g9j/RBhk+sVY/5rJSPqEFO5lA+dl5TzE5vu/EXePHbc='; style-src-elem 'self' 'sha256-BNmAHbO2/ek3x7c/V95X+65lWTk5Sab4/A58ijnWg0g=' 'sha256-g9j/RBhk+sVY/5rJSPqEFO5lA+dl5TzE5vu/EXePHbc='; style-src-attr 'none'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests

/json/*
  X-Robots-Tag: noindex, nofollow, noai, noimageai
  Cache-Control: public, max-age=0, must-revalidate

/reports/*
  X-Robots-Tag: noindex, nofollow, noarchive, noai, noimageai

# I file di queste tre cartelle non hanno un hash nel nome: "immutable" e' un
# contratto sul nome, non una proprieta' del contenuto. Per sostituirne uno va
# cambiato il nome del file, oppure alzato ASSETS_CACHE_NAME in sw.js (che li
# tiene in una cache mai invalidata). prepublish-check.sh blocca la sostituzione
# in place senza una delle due cose.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/screenshots/*
  Cache-Control: public, max-age=31536000, immutable

/questions-build-report.json
  X-Robots-Tag: noindex, nofollow, noai, noimageai


/404.html
  X-Robots-Tag: noindex, nofollow

/sw.js
  Cache-Control: no-cache

/app-version.js
  Cache-Control: no-cache
