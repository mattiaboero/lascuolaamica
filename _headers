# Questo file e' l'unica fonte degli header di risposta del sito. Non duplicarli
# in regole di zona Cloudflare: una regola di zona vince su questo file senza
# che dal repo si veda.
#
# Se in console ricompare su ogni pagina un errore CSP ("Executing inline script
# violates ... script-src 'self'") per uno script che carica
# /cdn-cgi/challenge-platform/scripts/jsd/main.js, non riguarda codice di questo
# repo: e' lo script anti-bot che Cloudflare inietta all'edge (JavaScript
# Detections).
#
# Non aggiungere un hash per farlo passare: lo script contiene il ray id della
# richiesta (r:'a384b1...'), quindi il suo hash cambia a ogni caricamento e
# nessun valore statico puo' corrispondere. E comunque il sito promette ai
# genitori che non usa strumenti di analisi o tracciamento.
#
# Va spento. E' spento dal 06/10/2026: sul piano gratuito il pannello non ha
# l'interruttore, l'API si' (bot_management della zona, campo enable_js a false).
# Spegnere Bot Fight Mode non basta.

# Cloudflare Pages aggiunge Access-Control-Allow-Origin: * a ogni risposta
# (c'e' anche su lascuolaamica.pages.dev). Il sito non chiede niente da altre
# origini a se stesso, e nessuna pagina deve essere leggibile via CORS da un
# altro sito: "! Access-Control-Allow-Origin" lo toglie ovunque. Se un file
# dovesse servire a un'altra origine, lo si riaggiunge solo su quel percorso.
/*
  ! Access-Control-Allow-Origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-DNS-Prefetch-Control: on
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), accelerometer=(), gyroscope=(), magnetometer=()
  Content-Security-Policy: require-trusted-types-for 'script'; trusted-types sa-sw-url sa-sw-import; default-src 'self'; script-src 'self'; style-src 'self' 'sha256-+FVmHapzsPfMYCATv2VC2GfK89PspwYWg6e/gzq213g=' 'sha256-IoJaRlKh+GMeAtmQ1sDH1tcq3oGsbJ9mhZjANV6Q2B8=' 'sha256-ND2NqmOiXOD5I18x/wBQVR0kNxO/5Pc161/aedx5/CY=' 'sha256-SvwBPjlFZVS3huuXvLng6ZDEAFBUSOIwMX7Omf8AbwE=' 'sha256-XmXENDeg3aE4JNS5z7xUnnXgMk/3h5UDKAThzLiWrd0=' 'sha256-bxDNNOn1GO2Cv3kTjL1ZLzVeFWsl25bMAdZdVROonyE=' 'sha256-cYFgphEJF9VHmlIOv/KSMGSnmeGzvL72Nplz5q2RO7c=' 'sha256-fAzpn8SvhIPi70bbUs20+LOR8RCRKUjQzrAwAt681J4=' 'sha256-tgMXhVvLCO7zePN0eHc8BqWQSKJf3xi+1TuvoQ+heJ0=' 'sha256-uEbCHr3ON8Z78HEa6U3UQXZKdL/THvoFhzZqBNVZ+g0='; style-src-elem 'self' 'sha256-+FVmHapzsPfMYCATv2VC2GfK89PspwYWg6e/gzq213g=' 'sha256-IoJaRlKh+GMeAtmQ1sDH1tcq3oGsbJ9mhZjANV6Q2B8=' 'sha256-ND2NqmOiXOD5I18x/wBQVR0kNxO/5Pc161/aedx5/CY=' 'sha256-SvwBPjlFZVS3huuXvLng6ZDEAFBUSOIwMX7Omf8AbwE=' 'sha256-XmXENDeg3aE4JNS5z7xUnnXgMk/3h5UDKAThzLiWrd0=' 'sha256-bxDNNOn1GO2Cv3kTjL1ZLzVeFWsl25bMAdZdVROonyE=' 'sha256-cYFgphEJF9VHmlIOv/KSMGSnmeGzvL72Nplz5q2RO7c=' 'sha256-fAzpn8SvhIPi70bbUs20+LOR8RCRKUjQzrAwAt681J4=' 'sha256-tgMXhVvLCO7zePN0eHc8BqWQSKJf3xi+1TuvoQ+heJ0=' 'sha256-uEbCHr3ON8Z78HEa6U3UQXZKdL/THvoFhzZqBNVZ+g0='; style-src-attr 'none'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests

/json/*
  X-Robots-Tag: noindex, nofollow, noai, noimageai
  Cache-Control: public, max-age=0, must-revalidate

/reports/*
  X-Robots-Tag: noindex, nofollow, noarchive, noai, noimageai

# I file di queste tre cartelle non hanno un hash nel nome: "immutable" e' un
# contratto sul nome, non una proprieta' del contenuto. Per sostituirne uno va
# cambiato il nome del file, oppure alzato ASSETS_CACHE_NAME in sw.js (che li
# tiene in una cache mai invalidata). prepublish-check.sh blocca la sostituzione
# in place senza una delle due cose.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# I modelli 3D del Sistema Solare: con application/octet-stream Cloudflare non
# li comprime (195 e 289 KB invece di circa 42 e 75). Il tipo serve solo a
# entrare nella lista dei tipi compressi di Cloudflare: il motore li legge con
# fetch().arrayBuffer() e non guarda il Content-Type.
/assets/sistema-solare/*.bin
  Content-Type: application/x-protobuf

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/screenshots/*
  Cache-Control: public, max-age=31536000, immutable

/questions-build-report.json
  X-Robots-Tag: noindex, nofollow, noai, noimageai


/404.html
  X-Robots-Tag: noindex, nofollow

/sw.js
  Cache-Control: no-cache

/app-version.js
  Cache-Control: no-cache
