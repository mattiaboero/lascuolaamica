{
  "name": "lascuolaamica",
  "version": "4.27.2",
  "private": true,
  "description": "Piattaforma quiz primaria italiana",
  "scripts": {
    "audit:json": "node scripts/audit_questions_json.js",
    "check:sw-precache": "node scripts/check_sw_precache.js",
    "check:storage-helpers": "node scripts/check_storage_helpers.js",
    "check:static-grids": "node scripts/check_static_grids.js",
    "check:percorso-sicuro": "node scripts/check_percorso_sicuro.js",
    "check:speech": "node scripts/check_speech_local.js",
    "check:grammar-rules": "node scripts/check_grammar_rules.js",
    "check:update-log": "node scripts/check_update_log.js",
    "audit:csp": "python3 scripts/sync_csp_hashes.py --check",
    "freshness": "python3 scripts/build_tabelline.py && python3 scripts/build_json_classi.py && python3 scripts/sync_question_counts.py && python3 scripts/refresh_structured_data.py && python3 scripts/generate_sitemap.py && python3 scripts/sync_csp_hashes.py",
    "lint:content": "node scripts/lint_content.js",
    "ingest": "python3 scripts/ingest_generated.py",
    "ingest:dry": "python3 scripts/ingest_generated.py --dry-run",
    "coverage": "node scripts/coverage_report.js",
    "test:harness": "node scripts/subject_quiz_test_harness.js",
    "sync:wiki": "bash scripts/sync_github_wiki.sh",
    "check:prepublish": "bash prepublish-check.sh",
    "lint:js": "eslint *.js js/ scripts/",
    "lint:css": "stylelint *.css",
    "lint": "npm run lint:js && npm run lint:css",
    "verify": "npm run check:materialized && npm run lint && npm run audit:json && npm run lint:content && npm run check:math && npm run check:plausibility && npm run check:revisione && npm run check:leggibilita && npm run check:bosco && npm run check:sistema-solare && npm run check:balance && npm run check:counts && npm run check:json-classi && npm run check:css-critico && npm run check:indexnow && npm run check:static-grids && npm run check:percorso-sicuro && npm run check:prepublish && npm run export && npm run check:export-canale",
    "lighthouse": "lhci autorun",
    "test:e2e:perfect": "bash scripts/run_e2e.sh perfect",
    "test:e2e:full": "bash scripts/run_e2e.sh perfect,mixed,worst",
    "test:e2e:ripassa": "bash scripts/run_e2e.sh ripassa",
    "test:e2e:interrupt": "bash scripts/run_e2e.sh interrupt",
    "test:e2e:dialogs": "bash scripts/run_e2e.sh dialogs",
    "test:e2e:subareas": "bash scripts/run_e2e.sh subareas",
    "test:e2e:tabelline": "node scripts/tabelline_smoke.js",
    "test:e2e:voci": "node scripts/voci_locali_smoke.js",
    "test:e2e:timer": "node scripts/timer_gioco_smoke.js",
    "test:e2e:viewport": "node scripts/quiz_viewport_smoke.js",
    "test:e2e:home": "node scripts/home_smoke.js",
    "test:e2e:cls": "node scripts/cls_smoke.js",
    "test:e2e:sw": "node scripts/sw_update_smoke.js",
    "test:e2e:versioni": "node scripts/sw_versioni_smoke.js",
    "test:e2e:focus": "node scripts/modal_focus_smoke.js",
    "test:e2e:json-classi": "node scripts/json_classi_smoke.js",
    "test:e2e:css-critico": "node scripts/css_critico_smoke.js",
    "test:e2e:trusted-types": "node scripts/trusted_types_smoke.js",
    "test:e2e:annunci": "node scripts/annunci_smoke.js",
    "test:e2e:a11y": "node scripts/a11y_smoke.js",
    "test:e2e:classe1": "node scripts/subject_quiz_test_harness.js --page matematica --class 1 --mode perfect --bonus easy",
    "test:e2e:install": "playwright install --with-deps chromium",
    "check:math": "node scripts/check_math_explanations.js",
    "check:plausibility": "node scripts/check_plausibility.js",
    "check:bosco": "node scripts/check_bosco.js",
    "check:sistema-solare": "python3 scripts/build_sistema_solare.py --check && node scripts/check_sistema_solare.js",
    "sync:counts": "python3 scripts/sync_question_counts.py",
    "check:counts": "python3 scripts/sync_question_counts.py --check",
    "check:json-classi": "python3 scripts/build_json_classi.py --check",
    "check:css-critico": "node scripts/build_css_critico.js --check",
    "css:critico": "node scripts/build_css_critico.js",
    "check:balance": "node scripts/check_answer_balance.js",
    "check:revisione": "node scripts/revisione_domande.js check",
    "check:leggibilita": "node scripts/revisione_domande.js leggibilita",
    "check:export-canale": "node scripts/check_export_canale.js",
    "check:materialized": "node scripts/check_files_materialized.js",
    "export": "bash scripts/export_for_cloudflare.sh",
    "check:contrast": "bash scripts/check_contrast.sh",
    "indexnow": "node scripts/indexnow.js",
    "check:indexnow": "node scripts/check_indexnow.js"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "axe-core": "4.11.4",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "playwright": "^1.64.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
