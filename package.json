{
  "name": "lascuolaamica",
  "version": "4.12.29",
  "private": true,
  "description": "Piattaforma quiz primaria italiana",
  "scripts": {
    "audit:json": "node scripts/audit_questions_json.js",
    "check:sw-precache": "node scripts/check_sw_precache.js",
    "check:update-log": "node scripts/check_update_log.js",
    "audit:csp": "python3 scripts/sync_csp_hashes.py --check",
    "freshness": "python3 scripts/refresh_structured_data.py && python3 scripts/generate_sitemap.py && python3 scripts/sync_csp_hashes.py",
    "lint:content": "node scripts/lint_content.js",
    "ingest": "python3 scripts/ingest_generated.py",
    "ingest:dry": "python3 scripts/ingest_generated.py --dry-run",
    "coverage": "node scripts/coverage_report.js",
    "test:harness": "node scripts/subject_quiz_test_harness.js",
    "sync:wiki": "bash scripts/sync_github_wiki.sh",
    "prepublish": "bash prepublish-check.sh",
    "lint:js": "eslint *.js js/ scripts/",
    "lint:css": "stylelint *.css",
    "lint": "npm run lint:js && npm run lint:css",
    "verify": "npm run lint && npm run audit:json && npm run lint:content && npm run prepublish",
    "lighthouse": "lhci autorun",
    "test:e2e:perfect": "bash scripts/run_e2e.sh perfect",
    "test:e2e:full": "bash scripts/run_e2e.sh perfect,mixed,worst",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "eslint": "^9.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "playwright": "^1.48.0"
  },
  "engines": {
    "node": ">=20"
  }
}
